<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RememberMePlusApp.AddTaskPage"
             Title="Añadir tarea">

    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Añadir tarea"
               Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Text="Provisional: esta pantalla crea solo tareas no recurrentes."
               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

        <Entry Placeholder="Título"
               Text="{Binding Title}" />

        <DatePicker Date="{Binding DueDate}" />

        <Button Text="Guardar tarea"
                Command="{Binding SaveCommand}" />

        <ActivityIndicator IsRunning="{Binding IsSaving}"
                           IsVisible="{Binding IsSaving}" />
    </VerticalStackLayout>

</ContentPage>
