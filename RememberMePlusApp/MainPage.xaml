<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RememberMePlusApp.MainPage"
             x:Name="MainPageRoot"
             Title="RememberMe+">

    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Tareas pendientes de hoy o vencidas"
               Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Text="Marca el check para completar cada tarea."
               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />

        <CollectionView ItemsSource="{Binding PendingTasks}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay tareas pendientes."
                       HorizontalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="4">
                        <CheckBox Grid.RowSpan="2"
                                  IsChecked="{Binding IsCompleted}"
                                  Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.CompleteTaskCommand}"
                                  CommandParameter="{Binding .}" />

                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               FontAttributes="Bold"
                               TextColor="{Binding TaskTextColor}"
                               LineBreakMode="TailTruncation" />

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding DueAt, StringFormat='Vence: {0}'}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
